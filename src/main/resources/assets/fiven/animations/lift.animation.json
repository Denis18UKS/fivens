{
  "format_version": "1.8.0",
  "animations": {
    "doors_closed": {
      "loop": true,
      "bones": {
        "right_door_lift": { "scale": [1, 1, 1] },
        "left_door_lift": { "scale": [1, 1, 1] }
      }
    },
    "doors_open": {
      "loop": "hold_on_last_frame",
      "animation_length": 1.5,
      "bones": {
        "right_door_lift": {
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "1.5": { "vector": [0.2, 1, 1] }
          }
        },
        "left_door_lift": {
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "1.5": { "vector": [0.2, 1, 1] }
          }
        }
      }
    }
  }
}
